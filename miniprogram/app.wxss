page {
  background: #f3f7ff;
  color: #16202e;
  font-size: 28rpx;
}

.panel {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 32, 46, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.hint {
  margin-top: 12rpx;
  color: #6b7686;
  font-size: 24rpx;
  line-height: 1.5;
}

.input {
  box-sizing: border-box;
  width: 100%;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 2rpx solid #dbe4ef;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 26rpx;
}

.button {
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  border-radius: 12rpx;
  background: #0ea5e9;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.button.secondary {
  background: #eef6ff;
  color: #0b7fb8;
}

.result {
  margin-top: 20rpx;
  color: #22705b;
  word-break: break-all;
}

.result.error {
  color: #b42318;
}

.side-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.side-row .button {
  flex: 1;
  margin-top: 0;
}
