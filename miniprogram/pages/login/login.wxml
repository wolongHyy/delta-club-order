<view class="page">
  <view class="brand">
    <text class="brand-title">三角洲游戏服务平台</text>
    <text class="brand-sub">登录同步微信身份与手机号</text>
  </view>

  <view class="card" wx:if="{{loggingIn}}">
    <text class="tip">正在获取微信登录状态…</text>
  </view>

  <view class="card" wx:else>
    <view class="row"><text class="label">微信身份</text><text class="value">{{openid ? '已同步（' + openid.slice(-6) + '）' : '未同步'}}</text></view>
    <view class="row" wx:if="{{phone}}"><text class="label">手机号</text><text class="value">{{phone}}</text></view>

    <button class="primary" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{loading}}">
      {{phone ? '已授权手机号，进入点单' : '授权手机号并进入点单'}}
    </button>
    <button class="plain" bindtap="skipPhone" disabled="{{loading}}">暂不绑定手机号，直接进入</button>

    <text class="error" wx:if="{{error}}">{{error}}</text>
    <text class="hint">手机号仅用于订单联系，打手接单后可见</text>
  </view>
</view>
