.page { min-height: 100vh; padding: 24px; background: linear-gradient(180deg, #0ea5e9 0%, #f3f7ff 40%); box-sizing: border-box; }
.brand { padding: 48px 0 32px; text-align: center; }
.brand-title { display: block; font-size: 28px; font-weight: 700; color: #fff; }
.brand-sub { display: block; margin-top: 8px; font-size: 13px; color: rgba(255,255,255,0.85); }
.card { background: #fff; border-radius: 16px; padding: 24px 20px; }
.tip { font-size: 14px; color: #666; }
.row { display: flex; justify-content: space-between; padding: 10px 0; font-size: 14px; border-bottom: 1px solid #f0f0f0; }
.label { color: #8b98a9; }
.value { color: #111; font-weight: 500; }
.primary { margin-top: 20px; background: #0ea5e9; color: #fff; border-radius: 12px; font-size: 15px; }
.plain { margin-top: 12px; background: #f3f7ff; color: #0ea5e9; border-radius: 12px; font-size: 14px; }
.error { display: block; margin-top: 14px; font-size: 12px; color: #e5484d; text-align: center; }
.hint { display: block; margin-top: 14px; font-size: 11px; color: #a0aab8; text-align: center; }
