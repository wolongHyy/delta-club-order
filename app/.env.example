# ===== 微信服务号配置（可选） =====
# 未配置时：微信一键登录按钮不显示，账号密码注册/登录完全照常可用。
# 配置后：用户/打手在微信内打开网页，可微信授权登录。

# 服务号 AppID（在 mp.weixin.qq.com → 设置与开发 → 基本配置 中查看）
WECHAT_APPID=

# 服务号 AppSecret（只显示一次，务必保存好；只放服务器环境变量，不要泄露）
WECHAT_SECRET=

# 授权范围：
#   snsapi_base      = 静默授权，只拿 openid（登录够用，推荐）
#   snsapi_userinfo  = 需要用户点击同意，可额外拿昵称、头像
WECHAT_SCOPE=snsapi_base

# 正式访问地址（必须 HTTPS，且与微信后台「网页授权域名」一致）
# 本地开发默认 http://localhost:3000，上线改成 https://你的域名
APP_BASE_URL=http://localhost:3000

# ===== 管理端登录与安全 Cookie =====
# 生产环境务必设置强密码和两个不同的 64 位随机字符串。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# ===== 订单自动取消 =====
# 0 表示关闭；30 表示待接单超过 30 分钟自动取消。
ORDER_AUTO_CANCEL_MINUTES=30

# ===== 限流器 =====
# 留空：单实例使用内存限流，速度快，不给数据库增加写锁。
# 设为 db：多实例部署时共享 SQLite 限流桶，但每个请求会多一次数据库写。
RATE_LIMIT_SHARED=

# ===== 手动维护接口 =====
# 调用 /api/maintenance/orders/cancel-expired 时需要带 X-Maintenance-Token。
MAINTENANCE_TOKEN=

# ===== 24h 智能客服（AI Customer Service）=====
# 兼容 OpenAI 接口地址。示例为 DeepSeek 官方接口（本机已接入）：
AI_ENABLED=1
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-你的DeepSeekKey
AI_MODEL=deepseek-chat
# 其他可选：智谱 GLM（免费 glm-4-flash）：https://open.bigmodel.cn/api/paas/v4
#         豆包/火山方舟等任意 OpenAI 兼容地址均可。
# 也可以在管理后台「智能客服 → 客服设置」里修改，环境变量优先级更高。
# 注意：.env 已被 .gitignore 排除，真实 Key 不要提交到仓库。
