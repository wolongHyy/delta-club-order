{
  "name": "delta-game-service-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-sqlite node_modules/next/dist/bin/next dev -p 3000 --webpack",
    "build": "node --experimental-sqlite node_modules/next/dist/bin/next build --webpack && node scripts/postbuild.cjs",
    "start": "node --experimental-sqlite server.js",
    "seed": "node --experimental-sqlite scripts/seed.cjs",
    "test": "node --experimental-sqlite --experimental-strip-types --test scripts/db-tests.ts",
    "seed:ai": "node --experimental-sqlite scripts/seed-knowledge.cjs"
  },
  "dependencies": {
    "next": "^16.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
